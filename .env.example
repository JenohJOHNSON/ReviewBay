# Neon Postgres. Paste the connection string from the Neon console.
# It usually includes sslmode=require.
DATABASE_URL=

# OpenAI generation for the review chatbot. Dashboard summaries use local Python ML.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_REASONING_EFFORT=low

# Airbyte Cloud trial imports Apify-backed sources into Neon staging tables.
AIRBYTE_SOURCE_MAP=config/airbyte_sources.yml
AIRBYTE_IMPORT_LIMIT=500

# Apify is used by Airbyte Cloud for web/review sources. The Python worker keeps
# the free app-store sources running without Apify.
APIFY_TOKEN=
# APIFY_TOKENS=token_a,token_b
# Bound an actor run so a hung actor cannot block the collection thread (and,
# with MAX_CONCURRENT_COLLECTIONS=1, every onboard queued behind it).
# APIFY_ACTOR_TIMEOUT_SECS=300
# APIFY_ACTOR_WAIT_SECS=330

# Optional source tuning.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
FETCH_LIMIT=50
WORKER_INTERVAL_SECONDS=900
ONBOARD_LIMIT=50
LOCAL_SOURCES=app_store,google_play
COLLECT_TARGET=200
COLLECT_FLOOR=150

# Optional app-store / Play-store overrides.
APP_STORE_COUNTRY=us
GOOGLE_PLAY_LANG=en
GOOGLE_PLAY_COUNTRY=us
# APP_STORE_ID_BLUE_BOTTLE_COFFEE=1440573734
# GOOGLE_PLAY_ID_BLUE_BOTTLE_COFFEE=com.example.app

# ===========================================================================
# Extraction engine: Scrapling (the "depth" pass)
# ===========================================================================
# Reads the pages the web search already discovered, instead of keeping only the
# two-sentence SERP snippet. ON by default, and safe to leave on: the base
# install is Scrapling's lxml parser plus the `requests` already in the image,
# so there is no browser and no extra memory.
SCRAPLING_ENABLED=1

# Fetch tier. "auto" (default) picks the cheapest INSTALLED tier and escalates
# to a browser only for a page that returned nothing AND looks client-rendered.
#   requests   plain HTTP (default; needs nothing beyond requirements.txt)
#   scrapling  Scrapling FetcherSession, reuses connections  [needs requirements-scraping.txt]
#   browser    real Chromium                                 [needs requirements-scraping.txt + playwright install]
SCRAPLING_FETCH_TIER=auto
# Must be 1 AND the browser installed before any browser is launched.
SCRAPLING_BROWSER_ENABLED=0

# How much fetching ONE collection run may do. These are the memory and
# wall-clock guardrails; raising them raises both.
SCRAPLING_MAX_PAGES=40              # total page fetches per run
SCRAPLING_MAX_PAGES_PER_DOMAIN=8    # stops one chatty site eating the budget
SCRAPLING_MAX_CONCURRENCY=4
SCRAPLING_REQUEST_TIMEOUT=20        # seconds per page
SCRAPLING_MAX_RETRIES=2
SCRAPLING_MAX_URLS=30               # discovered URLs the depth pass considers
SCRAPLING_FOLLOW_PAGINATION=1
SCRAPLING_MAX_PAGINATION_DEPTH=3
# Comma-separated domains known to need a browser; only used when the browser
# tier is installed and enabled.
# SCRAPLING_JS_HOSTS=
# Hosts the depth engine leaves alone because a dedicated connector covers them
# or their terms do not permit direct fetching. The default is a sensible list;
# override only if you know why.
# SCRAPLING_SKIP_HOSTS=

# Whole-run bounds shared by the engines.
SCRAPING_DEADLINE_SECONDS=240       # wall-clock ceiling for the fetching stages
SCRAPING_MAX_PAGE_BYTES=3145728     # 3MB per page, truncated past this
SCRAPING_MIN_TEXT_CHARS=40          # shorter than this is a nav label, not feedback
SCRAPING_MAX_TEXT_CHARS=4000
SCRAPING_MAX_RECORDS_PER_PAGE=60
SCRAPING_STRATEGIES=config/extraction_strategies.yml

# Politeness. Leave SCRAPING_OBEY_ROBOTS=1: it is the difference between reading
# public pages and ignoring a site's stated wishes. A site asking for a longer
# delay than SCRAPING_MAX_DELAY is skipped rather than hurried.
SCRAPING_OBEY_ROBOTS=1
SCRAPING_DEFAULT_DELAY=1.0          # seconds between requests to one domain
SCRAPING_MAX_DELAY=10
SCRAPING_ROBOTS_TIMEOUT=10
SCRAPING_ROBOTS_TTL=3600
# An honest, contactable user agent is how a site operator can ask us to stop.
# SCRAPING_USER_AGENT=ReviewBayBot/1.0 (+https://github.com/JenohJOHNSON/ReviewBay; brand-reputation research)
# SCRAPING_UA_TOKEN=ReviewBayBot

# ===========================================================================
# Extraction engine: ScrapeGraphAI (AI-assisted fallback)
# ===========================================================================
# OFF by default because it spends money per page. It is only ever offered a
# page that was fetched successfully and that no selector could read, so it
# never pays for a fetch and never re-reads a page we could already parse.
SCRAPEGRAPH_ENABLED=0

# Backend. "auto" prefers the scrapegraphai library when installed and otherwise
# uses the built-in path over the openai client this app already configures.
# The library is 74 extra packages; see requirements-ai-extraction.txt.
#   auto | scrapegraphai | native
SCRAPEGRAPH_BACKEND=auto
SCRAPEGRAPH_MODEL=gpt-4o-mini

# Spend controls, enforced BEFORE each call. The per-run cost ceiling is the one
# that actually protects the bill; the others shape how it is spent.
SCRAPEGRAPH_MAX_CALLS_PER_RUN=10
SCRAPEGRAPH_MAX_COST_PER_RUN=0.50   # USD, estimated from token counts
SCRAPEGRAPH_MAX_INPUT_TOKENS=12000  # refuse a page larger than this
SCRAPEGRAPH_MAX_CONTENT_CHARS=24000
SCRAPEGRAPH_MAX_RECORDS=40
SCRAPEGRAPH_TIMEOUT=90
# Extractions are cached by a hash of (content, objective, model), so the same
# page is never paid for twice, including across restarts and across brands.
SCRAPEGRAPH_CACHE_TTL=1209600       # 14 days
SCRAPEGRAPH_CACHE_IN_DB=1
# Override the price assumptions used for the cost estimate (USD per 1M tokens).
# SCRAPEGRAPH_PRICE_IN=0.15
# SCRAPEGRAPH_PRICE_OUT=0.60

# ===========================================================================
# Routing, data quality and enrichment
# ===========================================================================
# How eagerly to escalate between engines.
#   cheap     deterministic only, never spends on AI extraction
#   balanced  (default) AI extraction only for pages selectors could not read
#   thorough  also routes no-direct-fetch platforms to a vendor actor
SCRAPING_ENGINE_STRATEGY=balanced
# Demote a domain where the deterministic engine keeps failing.
ROUTING_MIN_SUCCESS_RATE=0.2
ROUTING_MIN_ATTEMPTS=4

# Fraction of an AI-extracted record's word 5-grams that must appear VERBATIM in
# the fetched page, or the record is discarded as paraphrased or invented.
# Lowering this trades the product's citation guarantee for recall.
EXTRACTION_SUPPORT_THRESHOLD=0.75
EXTRACTION_SUPPORT_NGRAM=5

# Validation and deduplication.
QUALITY_MIN_TEXT_CHARS=40
QUALITY_MAX_TEXT_CHARS=6000
QUALITY_REQUIRE_BRAND_MENTION=1     # drop obvious keyword collisions before storing
# Overlap above which two records on the SAME URL are one review read twice.
# Near-duplicate detection is scoped to one URL on purpose: two customers can
# write the same sentence on different pages, and merging them would delete real
# feedback.
QUALITY_NEAR_DUP_THRESHOLD=0.82

# Enrichment. 96 matches the embeddings API's per-request input batch, so one
# database read is one embedding call. Lower it only on a memory-constrained host.
ENRICH_BATCH=96
EMBED_MAX_ATTEMPTS=4
EMBED_BACKOFF_SECONDS=1.0

# LLM quality-control pass (brand relevance + sentiment).
#
# WORKER_QC=0 removes the pass from the worker's cycle. Leave it on: `relevant`
# is what every dashboard, trend, compare, export and RAG query filters on, and
# with the pass off every row stays NULL, so keyword collisions are never
# filtered out. It caps its own work at QC_MAX_ROWS and skips cleanly when
# OPENAI_API_KEY is unset.
WORKER_QC=1
QC_MODEL=gpt-4o-mini
QC_BATCH=25
QC_MAX_ROWS=600
QC_MAX_CHARS=600

# In-process caches for the generated insights and report payloads. Bounded, so
# a brand name arriving as a query parameter can no longer grow them without
# limit; see src/reviewbot/api/cache.py. Each entry holds a whole payload, so
# raise the size only if you genuinely track more brands than this.
INSIGHTS_TTL=900
REPORT_TTL=900

# Database connection reuse. DB_POOL=0 restores a fresh connection per call.
DB_POOL=1
DB_POOL_MAX_IDLE=4

# Collection concurrency. Raise only on a host with RAM to spare.
MAX_CONCURRENT_COLLECTIONS=1

# Local development ONLY: allows fetching 127.0.0.1 so the test fixture server
# can be reached. BOTH are required, so a single stray variable in production
# cannot open the SSRF guard.
# ALLOW_PRIVATE_FETCH=1
# REVIEWBAY_ENV=dev

# Optional password gate for public deployments.
AUTH_USER=
AUTH_PASS=

# Optional alerts.
ALERT_WEBHOOK_URL=
ALERT_MAX_PER_PASS=5
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=reviewbay@localhost
